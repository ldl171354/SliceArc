<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>SliceArc.App</RootNamespace>
    <AssemblyTitle>极限压缩</AssemblyTitle>
    <Product>极限压缩</Product>
    <Version>0.4.6</Version>

    <!-- The engine lives in Core, but the CCW/RCW plumbing is switched on per
         process, so the app that hosts it must opt in as well. -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <ApplicationIcon>Assets\SliceArc.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- ===================================================================
       Two builds from one source tree:
         Release        - the open, portable "green" build. No password
                          recovery code is compiled in at all.
         Release-Crack  - the private local build, with the archive password
                          recovery tool (ENABLE_CRACK).
       =================================================================== -->
  <PropertyGroup>
    <Configurations>Debug;Release;Release-Crack</Configurations>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release-Crack'">
    <DefineConstants>$(DefineConstants);ENABLE_CRACK</DefineConstants>
  </PropertyGroup>

  <!-- Keep the recovery tool out of the open build: its sources and window are
       dropped before compilation, so nothing but the #if branches in shared
       files remains. -->
  <ItemGroup Condition="'$(Configuration)' != 'Release-Crack'">
    <Compile Remove="Crack\**\*.cs" />
    <None Remove="Crack\**\*" />
    <Page Remove="Views\CrackWindow.xaml" />
    <Compile Remove="Views\CrackWindow.xaml.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SliceArc.Core\SliceArc.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Also a resource, so Window.Icon="Assets/SliceArc.ico" resolves. -->
    <Resource Include="Assets\SliceArc.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Theme palettes (Themes/Palette.*.xaml) are compiled as BAML automatically
         by the SDK's default Page glob. App.ApplyTheme loads them via pack:// URI. -->
  </ItemGroup>

  <ItemGroup>
    <!-- 7z.dll ships with the app. IncludeNativeLibrariesForSelfExtract bundles
         it into the single-file EXE and extracts it at runtime. -->
    <None Include="7z.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
