<Window x:Class="SliceArc.App.Views.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="极限压缩 — 批量重命名"
        Width="960" Height="680"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource B.Window}"
        Foreground="{DynamicResource B.Text}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"
        Icon="/Assets/SliceArc.ico"
        ShowInTaskbar="False">

    <Grid Margin="16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 顶部工具条 ==================== -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolButton}" Height="28" Click="OnChooseFolderClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" Margin="0,0,6,0" />
                        <TextBlock Text="选择文件夹" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Height="28" Margin="6,0,0,0" Click="OnAddFilesClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8E5;" Margin="0,0,6,0" />
                        <TextBlock Text="添加文件" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="PathText" Style="{StaticResource Caption}" Margin="12,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420"
                           Text="未选择任何文件或文件夹" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="模式" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="ModeBox" Style="{StaticResource MinimalComboBox}" Width="120"
                          VerticalAlignment="Center" SelectionChanged="OnModeChanged">
                    <ComboBoxItem Content="文件" Tag="file" />
                    <ComboBoxItem Content="文件夹" Tag="folder" />
                    <ComboBoxItem Content="扩展名" Tag="ext" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- ==================== 名称规则卡（文件 / 文件夹） ==================== -->
        <Border x:Name="RulesCard" Grid.Row="1" Background="{DynamicResource B.Surface}"
                BorderBrush="{DynamicResource B.Border}" BorderThickness="1" CornerRadius="6"
                Padding="12,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="重命名规则" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="RuleCountText" Style="{StaticResource Caption}" Margin="8,0,0,0"
                               Text="0 条规则" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,8,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="RuleTypeBox" Grid.Column="0" Style="{StaticResource MinimalComboBox}">
                        <ComboBoxItem Content="替换文本" Tag="replace" />
                        <ComboBoxItem Content="正则替换" Tag="regex" />
                        <ComboBoxItem Content="添加前缀" Tag="prefix" />
                        <ComboBoxItem Content="添加后缀" Tag="suffix" />
                        <ComboBoxItem Content="序号编号" Tag="number" />
                        <ComboBoxItem Content="大小写转换" Tag="case" />
                        <ComboBoxItem Content="删除文本" Tag="remove" />
                    </ComboBox>
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="+ 添加规则"
                            Height="26" Margin="6,0,0,0" Click="OnAddRuleClick" />
                </Grid>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="210">
                    <StackPanel x:Name="RulesPanel" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ==================== 后缀规则卡（扩展名模式） ==================== -->
        <Border x:Name="ExtCard" Grid.Row="1" Visibility="Collapsed"
                Background="{DynamicResource B.Surface}"
                BorderBrush="{DynamicResource B.Border}" BorderThickness="1" CornerRadius="6"
                Padding="12,10">
            <StackPanel>
                <TextBlock Text="后缀重命名规则" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                    <RadioButton x:Name="SimpleRadio" Content="单一后缀" IsChecked="True"
                                 GroupName="extsub" VerticalAlignment="Center" Checked="OnExtSubChanged" />
                    <RadioButton x:Name="CompoundRadio" Content="复合后缀（智能递进）" GroupName="extsub"
                                 Margin="18,0,0,0" VerticalAlignment="Center" Checked="OnExtSubChanged" />
                </StackPanel>

                <!-- 单一后缀 -->
                <Grid x:Name="SimplePane">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="原后缀：" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox x:Name="SimpleFromBox" Grid.Row="0" Grid.Column="1" Text=".rar"
                             Style="{StaticResource MinimalTextBox}" FontFamily="Consolas"
                             TextChanged="OnExtTextChanged" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="→" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="8,0,8,0" />
                    <TextBox x:Name="SimpleToBox" Grid.Row="0" Grid.Column="3" Text=".zip"
                             Style="{StaticResource MinimalTextBox}" FontFamily="Consolas"
                             TextChanged="OnExtTextChanged" />
                    <CheckBox x:Name="SimpleKeepCheck" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                              Style="{StaticResource MinimalCheckBox}" Content="保留原文件名"
                              IsChecked="True" Margin="0,8,0,0" Click="OnExtCheckChanged" />
                </Grid>

                <!-- 复合后缀 -->
                <StackPanel x:Name="CompoundPane" Visibility="Collapsed">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource B.TextDim}" FontSize="11.5"
                               Text="复合后缀指形如 archive.part1.rar、backup.7z.001 这类分卷压缩后缀。工具从识别库自动匹配，保留序号并对非序号部分做替换或重新编号。" />
                    <TextBlock x:Name="CompoundMatchText" Margin="0,6,0,8" FontSize="11.5"
                               Foreground="{DynamicResource B.TextDim}"
                               Text="加载文件后自动匹配…" />
                    <TextBlock Text="操作方式：" Style="{StaticResource Caption}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                        <RadioButton x:Name="CompoundOpReplace" Content="替换非序号部分" IsChecked="True"
                                     GroupName="cmpop" VerticalAlignment="Center" Checked="OnCompoundOpChanged" />
                        <RadioButton x:Name="CompoundOpRenumber" Content="重新编号" GroupName="cmpop"
                                     Margin="18,0,0,0" VerticalAlignment="Center" Checked="OnCompoundOpChanged" />
                        <RadioButton x:Name="CompoundOpBoth" Content="同时执行" GroupName="cmpop"
                                     Margin="18,0,0,0" VerticalAlignment="Center" Checked="OnCompoundOpChanged" />
                    </StackPanel>

                    <Grid x:Name="CompoundReplacePane" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="新后缀模板：" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox x:Name="CmpToTmplBox" Grid.Row="0" Grid.Column="1"
                                 Style="{StaticResource MinimalTextBox}" FontFamily="Consolas"
                                 TextChanged="OnExtTextChanged" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="模板中 N 代表序号占位符，例如 .partN.rar" Margin="0,4,0,0"
                                   Foreground="{DynamicResource B.TextFaint}" FontSize="11" />
                    </Grid>

                    <StackPanel x:Name="CompoundRenumberPane" Orientation="Horizontal">
                        <TextBlock Text="起始：" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                   Margin="0,0,4,0" />
                        <TextBox x:Name="RenStartBox" Text="1" Width="60" FontFamily="Consolas"
                                 Style="{StaticResource MinimalTextBox}" TextChanged="OnExtTextChanged" />
                        <TextBlock Text="步长：" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                   Margin="12,0,4,0" />
                        <TextBox x:Name="RenStepBox" Text="1" Width="60" FontFamily="Consolas"
                                 Style="{StaticResource MinimalTextBox}" TextChanged="OnExtTextChanged" />
                        <TextBlock Text="补零位数：" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                   Margin="12,0,4,0" />
                        <TextBox x:Name="RenPadBox" Text="2" Width="50" FontFamily="Consolas"
                                 Style="{StaticResource MinimalTextBox}" TextChanged="OnExtTextChanged" />
                        <CheckBox x:Name="RenKeepBaseCheck" Style="{StaticResource MinimalCheckBox}"
                                  Content="保留原基础名" IsChecked="True" Margin="14,0,0,0"
                                  VerticalAlignment="Center" Click="OnExtCheckChanged" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ==================== 预览 ==================== -->
        <Border Grid.Row="2" Margin="0,10,0,0" Background="{DynamicResource B.Surface}"
                BorderBrush="{DynamicResource B.Border}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Background="{DynamicResource B.SurfaceAlt}">
                    <TextBlock Text="重命名预览" FontWeight="SemiBold" Margin="12,8,0,8" />
                    <TextBlock x:Name="PreviewCountText" Style="{StaticResource Caption}"
                               HorizontalAlignment="Right" Margin="0,0,12,0" Text="共 0 项" />
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,8,10,6">
                    <Button Style="{StaticResource ToolButton}" Content="刷新预览" Height="26"
                            Click="OnRefreshClick" />
                    <Button x:Name="UndoButton" Style="{StaticResource OutlineButton}" Content="撤销上次"
                            Height="26" Margin="6,0,0,0" Click="OnUndoClick" />
                    <Button x:Name="ApplyToolbarButton" Style="{StaticResource PrimaryButton}" Content="应用重命名"
                            Height="26" Margin="6,0,0,0" Click="OnApplyClick" IsEnabled="False" />
                </StackPanel>
                <DataGrid x:Name="PreviewGrid" Grid.Row="2" Style="{StaticResource MinimalDataGrid}"
                          Margin="1,0,1,1">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="42" Header="选">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource MinimalCheckBox}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsEnabled="{Binding CanSelect}"
                                              IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="#" Width="46" Binding="{Binding Index}" />
                        <DataGridTextColumn Header="原名称" Width="*" Binding="{Binding Original}" />
                        <DataGridTextColumn Header="新名称" Width="*" Binding="{Binding Next}" />
                        <DataGridTemplateColumn Header="状态" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource B.TextFaint}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="ok">
                                                        <Setter Property="Foreground" Value="{DynamicResource B.Accent}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="warn">
                                                        <Setter Property="Foreground" Value="{DynamicResource B.Danger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ==================== 底部按钮 ==================== -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource OutlineButton}" Content="取消" Width="80" Height="28"
                    Click="OnCancelClick" />
            <Button x:Name="ApplyFooterButton" Style="{StaticResource PrimaryButton}" Content="应用"
                    Width="80" Height="28" Margin="8,0,0,0" Click="OnApplyClick" IsEnabled="False" />
        </StackPanel>
    </Grid>
</Window>
