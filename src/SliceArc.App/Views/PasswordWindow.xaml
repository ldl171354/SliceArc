<Window x:Class="SliceArc.App.Views.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="极限压缩 — 需要口令"
        Width="420" SizeToContent="Height" MaxWidth="520"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource B.Window}"
        Foreground="{DynamicResource B.Text}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"
        Icon="/Assets/SliceArc.ico">

    <Grid Margin="22,20,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- headline -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Width="40" Height="40" VerticalAlignment="Top">
                <Ellipse Fill="{DynamicResource B.AccentSoft}" />
                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                           FontSize="18" Foreground="{DynamicResource B.Accent}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Top">
                <TextBlock x:Name="TitleText" Text="这个压缩包已加密" FontSize="14" FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="SummaryText" Margin="0,5,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource B.TextDim}" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" Text="口令" Style="{StaticResource Caption}" Margin="0,16,0,4" />
        <PasswordBox x:Name="PasswordInput" Grid.Row="2" Style="{StaticResource MinimalPasswordBox}"
                     Height="28" PasswordChar="●" />

        <TextBlock x:Name="ErrorText" Grid.Row="3" Margin="0,8,0,0" TextWrapping="Wrap"
                   Visibility="Collapsed" Foreground="{DynamicResource B.Danger}" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource OutlineButton}" Content="取消" Width="88" Height="28"
                    Click="OnCancelClick" IsCancel="True" />
            <Button Style="{StaticResource PrimaryButton}" Content="确定" Width="88" Height="28"
                    Margin="8,0,0,0" Click="OnOkClick" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
