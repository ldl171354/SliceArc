<Window x:Class="SliceArc.App.Views.CompressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="极限压缩 — 压缩"
        Width="480" Height="540"
        MinWidth="420" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource B.Window}"
        Foreground="{DynamicResource B.Text}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"
        Icon="/Assets/SliceArc.ico"
        ShowInTaskbar="False">

    <Grid Margin="16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- sources -->
        <TextBlock Grid.Row="0" Text="要压缩的文件 / 文件夹" Style="{StaticResource Caption}" Margin="0,0,0,4" />
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox x:Name="SourcesBox" Grid.Row="0" Style="{StaticResource MinimalTextBox}"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Height="80" Padding="7,4" VerticalAlignment="Top"
                     TextChanged="OnSourcesChanged" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                <Button Style="{StaticResource ToolButton}" Click="OnAddFilesClick" Height="26">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8E5;" Margin="0,0,6,0" />
                        <TextBlock Text="添加文件…" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="OnAddFolderClick" Height="26" Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" Margin="0,0,6,0" />
                        <TextBlock Text="添加文件夹…" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- output -->
        <TextBlock Grid.Row="2" Text="压缩包路径" Style="{StaticResource Caption}" Margin="0,10,0,4" />
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="OutputBox" Grid.Column="0" Style="{StaticResource MinimalTextBox}"
                     TextChanged="OnOutputChanged" />
            <Button x:Name="BrowseOutput" Grid.Column="1" Style="{StaticResource ToolButton}"
                    Click="OnBrowseOutputClick" Height="26" Margin="6,0,0,0" Content="浏览…" />
        </Grid>

        <!-- format + level -->
        <TextBlock Grid.Row="4" Text="格式 / 级别" Style="{StaticResource Caption}" Margin="0,10,0,4" />
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="FormatBox" Grid.Column="0" Height="26" VerticalContentAlignment="Center"
                      Style="{StaticResource MinimalComboBox}"
                      SelectionChanged="OnFormatChanged">
                <ComboBoxItem Content="7z — LZMA2（默认）" Tag="SevenZip" />
                <ComboBoxItem Content="zip — 通用兼容" Tag="Zip" />
                <ComboBoxItem Content="tar — 未压缩" Tag="Tar" />
                <ComboBoxItem Content="gz — gzip" Tag="GZip" />
                <ComboBoxItem Content="bz2 — bzip2" Tag="BZip2" />
                <ComboBoxItem Content="xz — LZMA2" Tag="Xz" />
                <ComboBoxItem Content="zst — zstd" Tag="Zstd" />
                <ComboBoxItem Content="wim — WIM" Tag="Wim" />
            </ComboBox>
            <ComboBox x:Name="LevelBox" Grid.Column="1" Height="26" VerticalContentAlignment="Center"
                      Style="{StaticResource MinimalComboBox}"
                      Margin="6,0,0,0" SelectedIndex="4">
                <ComboBoxItem Content="0 — 存储" />
                <ComboBoxItem Content="1 — 最快" />
                <ComboBoxItem Content="3 — 快速" />
                <ComboBoxItem Content="5 — 标准" />
                <ComboBoxItem Content="7 — 最大" />
                <ComboBoxItem Content="9 — 极限" />
            </ComboBox>
        </Grid>

        <!-- volume + method -->
        <TextBlock Grid.Row="6" Text="分卷大小 / 方法（可选）" Style="{StaticResource Caption}" Margin="0,10,0,4" />
        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Editable so a custom size still works, but the common sizes are one
                 click away instead of being typed by hand. -->
            <ComboBox x:Name="VolumeBox" Grid.Column="0" Height="26" IsEditable="True"
                      VerticalContentAlignment="Center"
                      Style="{StaticResource MinimalComboBox}"
                      ToolTip="留空 = 不分卷。可直接选，也可自己填 50MB、1GB、1048576">
                <ComboBoxItem Content="不分卷" Tag="0" />
                <ComboBoxItem Content="10 MB" Tag="10485760" />
                <ComboBoxItem Content="50 MB" Tag="52428800" />
                <ComboBoxItem Content="100 MB" Tag="104857600" />
                <ComboBoxItem Content="500 MB" Tag="524288000" />
                <ComboBoxItem Content="1 GB" Tag="1073741824" />
                <ComboBoxItem Content="4 GB" Tag="4294967296" />
            </ComboBox>
            <TextBox x:Name="MethodBox" Grid.Column="1" Style="{StaticResource MinimalTextBox}"
                     Margin="6,0,0,0"
                     ToolTip="留空 = 默认方法。可填 LZMA2、Deflate、Zstd 等" />
        </Grid>

        <!-- password + options -->
        <TextBlock Grid.Row="8" Text="密码 / 选项" Style="{StaticResource Caption}" Margin="0,10,0,4" />
        <Grid Grid.Row="9" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <PasswordBox x:Name="PasswordBox" Grid.Row="0" Grid.Column="0"
                     Style="{StaticResource MinimalPasswordBox}"
                     ToolTip="留空 = 不加密。填写后 7z / zip 均使用 AES-256 加密" />
            <StackPanel Grid.Row="0" Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                <CheckBox x:Name="EncryptHeadersCheck" Style="{StaticResource MinimalCheckBox}"
                          Content="加密文件名" Margin="0,0,0,4" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                <CheckBox x:Name="SolidCheck" Style="{StaticResource MinimalCheckBox}"
                          Content="固实（更好压缩率）" IsChecked="True" />
            </StackPanel>
        </Grid>

        <!-- buttons -->
        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}"
                    Content="压缩" Width="90" Height="28"
                    Click="OnOkClick" IsEnabled="False" />
            <Button Style="{StaticResource ToolButton}" Content="取消" Width="70" Height="28"
                    Margin="8,0,0,0" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
