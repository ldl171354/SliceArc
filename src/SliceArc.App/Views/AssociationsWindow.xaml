<Window x:Class="SliceArc.App.Views.AssociationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="超速解压缩 — 文件关联"
        Width="640" Height="540" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource B.Window}"
        Foreground="{DynamicResource B.Text}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"
        Icon="/Assets/SliceArc.ico">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== explanation + bulk actions ==================== -->
        <Border Grid.Row="0" Background="{DynamicResource B.Surface}"
                BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                CornerRadius="6" Padding="14,12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource B.TextDim}"
                           Text="勾选希望由「超速解压缩」默认打开的压缩包格式，然后点「重新绑定」。如果默认程序被其他软件改走，回到这里重绑即可。" />
                <TextBlock Margin="0,6,0,10" TextWrapping="Wrap" Foreground="{DynamicResource B.TextFaint}"
                           Text="注意：Windows 不允许程序静默修改默认打开方式，部分格式需要你在随后弹出的系统「默认应用」界面确认。" />
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Height="26" Content="全选" Click="OnSelectAllClick" />
                    <Button Style="{StaticResource ToolButton}" Height="26" Content="全不选" Click="OnSelectNoneClick"
                            Margin="4,0,0,0" />
                    <Rectangle Width="1" Height="16" Fill="{DynamicResource B.Border}" Margin="8,0" />
                    <Button Style="{StaticResource ToolButton}" Height="26" Click="OnRefreshClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" Margin="0,0,6,0" />
                            <TextBlock Text="刷新当前状态" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ==================== extension list ==================== -->
        <DataGrid x:Name="TypeGrid" Grid.Row="1"
                  Style="{StaticResource MinimalDataGrid}"
                  IsReadOnly="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="44">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox Style="{StaticResource MinimalCheckBox}"
                                      HorizontalAlignment="Center"
                                      IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="扩展名" Binding="{Binding Extension}" Width="96" IsReadOnly="True" />
                <DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="*" IsReadOnly="True" />
                <DataGridTemplateColumn Header="当前默认打开方式" Width="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CurrentDefault}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Foreground" Value="{DynamicResource B.TextDim}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource B.Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ==================== footer ==================== -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="StatusText" Style="{StaticResource Caption}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource OutlineButton}" Content="关闭" Width="88" Height="30"
                        Click="OnCloseClick" Margin="0,0,8,0" IsCancel="True" />
                <Button Style="{StaticResource PrimaryButton}" Content="重新绑定" Width="112" Height="30"
                        Click="OnBindClick" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
