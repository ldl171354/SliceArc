<Window x:Class="SliceArc.App.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="图片预览" Width="1100" Height="760" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="#14171C"
        UseLayoutRounding="True" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#262B33"/>
            <Setter Property="Foreground" Value="#D7DCE3"/>
            <Setter Property="BorderBrush" Value="#3A414B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#323945"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#5B626D"/>
                                <Setter Property="Background" Value="#1D2127"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：文件名 -->
        <Border Grid.Row="0" Background="#101318" BorderBrush="#23282F" BorderThickness="0,0,0,1" Padding="16,10">
            <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" Foreground="#D7DCE3"
                       TextTrimming="CharacterEllipsis"/>
        </Border>

        <!-- 画布：缩放 + 平移 -->
        <Grid Grid.Row="1" x:Name="Viewport" ClipToBounds="True" Background="#0E1116"
              MouseLeftButtonDown="OnPanStart" MouseMove="OnPanMove"
              MouseLeftButtonUp="OnPanEnd" MouseLeave="OnPanEnd"
              MouseWheel="OnWheel">
            <Image x:Name="ImageHost" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="Zoom"/>
                        <TranslateTransform x:Name="Pan"/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
            <TextBlock x:Name="HintText" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#5B626D" FontSize="15" Text=""/>
        </Grid>

        <!-- 底部：导航与缩放 -->
        <Border Grid.Row="2" Background="#101318" BorderBrush="#23282F" BorderThickness="0,1,0,0" Padding="14,9">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="PrevButton" Content="← 上一张 (←)" Click="OnPrev"/>
                    <Button x:Name="NextButton" Content="下一张 (→)" Margin="8,0,0,0" Click="OnNext"/>
                </StackPanel>
                <TextBlock x:Name="CountText" DockPanel.Dock="Left" Margin="16,0,0,0" VerticalAlignment="Center"
                           Foreground="#8A93A0" FontSize="13"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="－" Click="OnZoomOut"/>
                    <TextBlock x:Name="InfoText" Margin="10,0" VerticalAlignment="Center" Foreground="#8A93A0"
                               FontSize="13" MinWidth="150" TextAlignment="Center"/>
                    <Button Content="＋" Click="OnZoomIn"/>
                    <Button Content="适应窗口 (0)" Margin="8,0,0,0" Click="OnFitClick"/>
                </StackPanel>
                <Grid/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
