<Window x:Class="SliceArc.App.Views.VerifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="极限压缩 — 压缩包校验"
        Width="880" Height="600" MinWidth="680" MinHeight="440"
        Background="{DynamicResource B.Window}"
        Foreground="{DynamicResource B.Text}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"
        Icon="/Assets/SliceArc.ico"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnFilesDropped">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== toolbar ==================== -->
        <Border Grid.Row="0" Background="{DynamicResource B.Surface}"
                BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                CornerRadius="6" Padding="8,6" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Click="OnAddFilesClick"
                            ToolTip="添加要校验的压缩包（可多选）">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8E5;" Margin="0,0,7,0" />
                            <TextBlock Text="添加文件" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="OnAddFolderClick"
                            ToolTip="添加一个文件夹里的全部压缩包">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" Margin="0,0,7,0" />
                            <TextBlock Text="添加文件夹" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource B.Border}" Margin="6,0" />
                    <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Click="OnStartClick"
                            Padding="16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" Margin="0,0,7,0" />
                            <TextBlock Text="开始校验" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopButton" Style="{StaticResource OutlineButton}" Click="OnStopClick"
                            IsEnabled="False" Margin="6,0,0,0">
                        <TextBlock Text="停止" />
                    </Button>
                    <Button x:Name="ClearButton" Style="{StaticResource ToolButton}" Click="OnClearClick"
                            Margin="4,0,0,0">
                        <TextBlock Text="清空" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="口令" Style="{StaticResource Caption}" Margin="0,0,6,0" />
                    <PasswordBox x:Name="PasswordInput" Width="150" Style="{StaticResource MinimalPasswordBox}"
                                 ToolTip="校验加密压缩包时使用的口令（可留空）" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== archive list ==================== -->
        <DataGrid x:Name="ArchiveGrid" Grid.Row="1"
                  Style="{StaticResource MinimalDataGrid}"
                  SelectionChanged="OnGridSelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="压缩包" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="格式" Binding="{Binding Format}" Width="90" />
                <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="90" />
                <DataGridTextColumn Header="条目" Binding="{Binding EntryCount}" Width="70" />
                <DataGridTextColumn Header="失败" Binding="{Binding Failed}" Width="70" />
                <DataGridTemplateColumn Header="状态" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Status}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Foreground" Value="{DynamicResource B.TextDim}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="校验中…">
                                                <Setter Property="Foreground" Value="{DynamicResource B.Accent}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="校验通过">
                                                <Setter Property="Foreground" Value="{DynamicResource B.Accent}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="发现损坏">
                                                <Setter Property="Foreground" Value="{DynamicResource B.Danger}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="需要口令">
                                                <Setter Property="Foreground" Value="{DynamicResource B.Danger}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="无法校验">
                                                <Setter Property="Foreground" Value="{DynamicResource B.Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ==================== details of the selected archive ==================== -->
        <Border Grid.Row="2" Margin="0,10,0,0"
                Background="{DynamicResource B.SurfaceAlt}"
                BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                CornerRadius="6" Padding="10,8" Height="150">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="损坏明细" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="DetailSummary" Text="" Style="{StaticResource Caption}"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <DataGrid Grid.Row="1" Style="{StaticResource MinimalDataGrid}"
                          ItemsSource="{Binding ElementName=ArchiveGrid, Path=SelectedItem.Issues}"
                          HeadersVisibility="None">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding EntryPath}" Width="*" />
                        <DataGridTextColumn Binding="{Binding SizeText}" Width="90" />
                        <DataGridTextColumn Binding="{Binding Description}" Width="220" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ==================== progress + footer ==================== -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ProgressBar x:Name="Bar" Grid.Row="0" Style="{StaticResource MinimalProgressBar}"
                         Height="5" Margin="0,0,0,8" />

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Text="把压缩包或文件夹拖进来，或点「添加文件」"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Foreground="{DynamicResource B.TextDim}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource OutlineButton}" Click="OnCloseClick" Width="88" Height="28"
                            Content="关闭" IsCancel="True" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
