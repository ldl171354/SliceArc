<Window x:Class="SliceArc.App.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="欢迎使用 超速解压缩"
        Width="560" Height="620" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource B.Window}"
        Foreground="{DynamicResource B.Text}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"
        Icon="/Assets/SliceArc.ico">

    <Grid Margin="24,18,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== header ==================== -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Image Source="/Assets/SliceArc.ico" Width="52" Height="52" VerticalAlignment="Top" />
            <StackPanel Margin="14,2,0,0" VerticalAlignment="Center">
                <TextBlock Text="欢迎使用 超速解压缩" FontSize="19" FontWeight="SemiBold" />
                <TextBlock Text="首次使用，请花几秒了解一下，并选择要关联的压缩包格式。"
                           Margin="0,5,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource B.TextDim}" />
            </StackPanel>
        </StackPanel>

        <!-- ==================== scrollable body ==================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- features -->
                <Border Background="{DynamicResource B.Surface}"
                        BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                        CornerRadius="6" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="软件特色" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,8" />
                        <TextBlock Margin="0,0,0,5" TextWrapping="Wrap" Foreground="{DynamicResource B.TextDim}"
                                   Text="•  分卷压缩包一键解压：.z01 / .001 / .part1.rar 等自动识别，边解压边回收已用完的分卷，省下一份完整磁盘空间。" />
                        <TextBlock Margin="0,0,0,5" TextWrapping="Wrap" Foreground="{DynamicResource B.TextDim}"
                                   Text="•  零临时文件：把列表里的文件直接拖到资源管理器，全程不产生中间文件。" />
                        <TextBlock Margin="0,0,0,5" TextWrapping="Wrap" Foreground="{DynamicResource B.TextDim}"
                                   Text="•  右键菜单集成：Windows 11 一级菜单，解压 / 压缩 / 校验一步到位。" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource B.TextDim}"
                                   Text="•  内置工具：压缩包完整性校验、批量重命名。" />
                    </StackPanel>
                </Border>

                <!-- notes -->
                <Border Margin="0,10,0,0"
                        Background="{DynamicResource B.SurfaceAlt}"
                        BorderBrush="{DynamicResource B.Border}" BorderThickness="3,0,0,0"
                        CornerRadius="6" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="注意事项" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,8" />
                        <TextBlock Margin="0,0,0,5" TextWrapping="Wrap" Foreground="{DynamicResource B.TextDim}"
                                   Text="•  Windows 不允许程序自动抢占「默认打开方式」。点「立即绑定」后若弹出系统「默认应用」界面，请在那里确认超速解压缩。" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource B.TextDim}"
                                   Text="•  只绑定你勾选的格式，不会改动其他程序。绑定随时可在「设置 → 文件关联…」重新设置（例如默认程序被其他软件改走后）。" />
                    </StackPanel>
                </Border>

                <!-- association picker -->
                <Border Margin="0,10,0,0"
                        Background="{DynamicResource B.Surface}"
                        BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                        CornerRadius="6" Padding="14,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="关联压缩包格式" FontWeight="SemiBold" FontSize="12.5"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource ToolButton}" Height="24" Content="全选"
                                        Click="OnSelectAllClick" />
                                <Button Style="{StaticResource ToolButton}" Height="24" Content="全不选"
                                        Click="OnSelectNoneClick" Margin="2,0,0,0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource B.TextDim}"
                                   Text="勾选后，双击这些压缩包将默认用超速解压缩打开：" />
                        <ItemsControl x:Name="TypeList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource MinimalCheckBox}" Margin="0,3"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Extension}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Description}" Margin="7,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource B.TextDim}" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== footer ==================== -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="SelectionText" Style="{StaticResource Caption}"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource OutlineButton}" Content="稍后再说" Width="96" Height="30"
                        Click="OnLaterClick" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="立即绑定" Width="112" Height="30"
                        Click="OnBindClick" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
