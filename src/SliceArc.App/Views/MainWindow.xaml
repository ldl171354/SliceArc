<Window x:Class="SliceArc.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="极限压缩"
        Width="960" Height="600" MinWidth="720" MinHeight="420"
        Background="{DynamicResource B.Window}"
        Foreground="{DynamicResource B.Text}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"
        Icon="/Assets/SliceArc.ico"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnFilesDropped"
        KeyDown="OnWindowKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- update banner: only rendered when a newer release exists -->
        <Border x:Name="UpdateBanner" Grid.Row="0" Background="#E8F0FE"
                BorderBrush="#2F6FEB" BorderThickness="0,0,0,1" Padding="14,7"
                Visibility="Collapsed">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#1C4FB8">
                    <Run x:Name="UpdateBannerText" Text="发现新版本" />
                </TextBlock>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="前往下载" Padding="10,3" Click="OnUpdateGoClick"
                            Background="#2F6FEB" Foreground="White" BorderBrush="#2F6FEB"
                            Cursor="Hand" />
                    <Button Content="跳过此版本" Padding="8,3" Margin="8,0,0,0" Click="OnUpdateSkipClick"
                            Background="Transparent" Foreground="#1C4FB8" BorderBrush="#9DBBF5"
                            Cursor="Hand" />
                    <Button Content="✕" Padding="6,3" Margin="8,0,0,0" Click="OnUpdateCloseClick"
                            Background="Transparent" Foreground="#1C4FB8" BorderBrush="Transparent"
                            Cursor="Hand" />
                </StackPanel>
                <Grid />
            </DockPanel>
        </Border>

        <!-- ==================== toolbar ==================== -->
        <Border Grid.Row="0" Background="{DynamicResource B.Surface}"
                BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1"
                Padding="8,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="OpenButton" Style="{StaticResource ToolButton}" Click="OnOpenClick"
                            ToolTip="打开压缩包或文件夹（Ctrl+O）">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8E5;" Margin="0,0,7,0" />
                            <TextBlock Text="打开" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <!-- 上一层 / 刷新贴着打开键：这是浏览压缩包时最常用的两个动作 -->
                    <Button x:Name="UpButton" Style="{StaticResource IconButton}" Click="OnUpClick"
                            ToolTip="上一级（Backspace）">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74A;" />
                    </Button>
                    <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Click="OnRefreshClick"
                            ToolTip="刷新（F5）">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" />
                    </Button>
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource B.Border}" Margin="6,0" />
                    <Button x:Name="CompressButton" Style="{StaticResource ToolButton}" Click="OnCompressClick"
                            ToolTip="把选中的文件 / 文件夹压缩成压缩包">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8D9;" Margin="0,0,7,0" />
                            <TextBlock Text="压缩" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="AddButton" Style="{StaticResource ToolButton}" Click="OnAddFilesClick"
                            ToolTip="把文件 / 文件夹添加进当前打开的压缩包（同名文件会被替换）；也可以直接把文件拖进窗口">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" Margin="0,0,7,0" />
                            <TextBlock Text="添加" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource B.Border}" Margin="6,0" />
                    <Button x:Name="ExtractButton" Style="{StaticResource ToolButton}" Click="OnExtractToClick"
                            ToolTip="解压到指定文件夹…">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" Margin="0,0,7,0" />
                            <TextBlock Text="解压到…" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="QuickExtractButton" Style="{StaticResource ToolButton}" Click="OnQuickExtractClick"
                            ToolTip="解压到以压缩包命名的子文件夹">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" Margin="0,0,7,0" />
                            <TextBlock Text="快速解压" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="TestButton" Style="{StaticResource ToolButton}" Click="OnTestClick"
                            ToolTip="只校验 CRC，不写任何文件">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" Margin="0,0,7,0" />
                            <TextBlock Text="测试" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource B.Border}" Margin="6,0" />
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource B.Border}" Margin="6,0" />
                    <Button x:Name="ToolsButton" Style="{StaticResource ToolButton}" Click="OnToolsClick"
                            ToolTip="工具箱：压缩包校验、批量重命名">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE90F;" Margin="0,0,7,0" />
                            <TextBlock Text="工具" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="8"
                                       Margin="5,1,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <!-- compact filter -->
                    <Grid Width="180" Margin="0,0,8,0">
                        <TextBox x:Name="FilterBox" Style="{StaticResource MinimalTextBox}"
                                TextChanged="OnFilterChanged" Height="26" />
                        <TextBlock Text="筛选…" IsHitTestVisible="False" Margin="9,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource B.TextFaint}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <!-- settings button -->
                    <Button x:Name="SettingsToggle" Style="{StaticResource ToolButton}"
                            Click="OnSettingsClick"
                            ToolTip="设置（分卷自动删除 / 右键菜单 / 主题）">
                        <TextBlock Text="设置" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- settings popup (shared popup, not a child of the toggle to avoid clipping) -->
        <Popup x:Name="SettingsPopup" Grid.Row="0" PlacementTarget="{Binding ElementName=SettingsToggle}"
               Placement="Bottom" HorizontalOffset="-230" VerticalOffset="4"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource B.Surface}"
                    BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                    CornerRadius="6" Padding="14,12" Width="280">
                <StackPanel>
                    <TextBlock Text="解压选项" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" />

                    <CheckBox x:Name="DeleteSpentCheck" Style="{StaticResource MinimalCheckBox}"
                              Content="解压后删除已用完的分卷"
                              ToolTip="每解压完一卷就立即回收该卷的磁盘空间（最后几卷永不删除）"
                              Click="OnDeleteSpentToggled" Margin="0,0,0,6" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="保留最后" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <ComboBox x:Name="KeepLastBox" Width="50" Height="24" FontSize="12" Margin="6,0"
                                  Style="{StaticResource MinimalComboBox}" MinHeight="0"
                                  VerticalContentAlignment="Center" SelectedIndex="1"
                                  SelectionChanged="OnKeepLastChanged"
                                  ToolTip="最后 N 卷永远不自动删除">
                            <ComboBoxItem Content="0" />
                            <ComboBoxItem Content="1" />
                            <ComboBoxItem Content="2" />
                            <ComboBoxItem Content="3" />
                        </ComboBox>
                        <TextBlock Text="卷" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    </StackPanel>

                    <CheckBox x:Name="ShellMenuCheck" Style="{StaticResource MinimalCheckBox}"
                              Content="注册右键菜单"
                              ToolTip="在当前用户注册表中安装 / 移除 Explorer 右键菜单（无需管理员）"
                              Click="OnShellMenuToggled" Margin="0,0,0,10" />

                    <Separator Margin="0,0,0,8" />

                    <TextBlock Text="完成提示" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" />
                    <CheckBox x:Name="ShowCompleteCheck" Style="{StaticResource MinimalCheckBox}"
                              Content="完成后弹出确认框"
                              ToolTip="解压 / 压缩结束后弹出结果确认框（右键后台运行也能看到结果）"
                              Click="OnCompletionToggled" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <CheckBox x:Name="PlaySoundCheck" Style="{StaticResource MinimalCheckBox}"
                                  Content="完成后播放提示音"
                                  ToolTip="挂在后台时靠声音知道解压结束了"
                                  Click="OnCompletionToggled" VerticalAlignment="Center" />
                        <ComboBox x:Name="SoundBox" Width="86" Height="24" FontSize="12"
                                  Style="{StaticResource MinimalComboBox}" MinHeight="0"
                                  VerticalContentAlignment="Center" SelectedIndex="0"
                                  SelectionChanged="OnSoundChanged"
                                  ToolTip="成功时播放的声音（失败固定播放「警告」）">
                            <ComboBoxItem Content="提示" Tag="Asterisk" />
                            <ComboBoxItem Content="感叹" Tag="Exclamation" />
                            <ComboBoxItem Content="蜂鸣" Tag="Beep" />
                            <ComboBoxItem Content="警告" Tag="Hand" />
                            <ComboBoxItem Content="提问" Tag="Question" />
                        </ComboBox>
                    </StackPanel>

                    <Separator Margin="0,0,0,8" />

                    <TextBlock Text="主题" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ThemeLight" Style="{StaticResource ToolButton}" Height="26"
                                Click="OnThemeClick" Tag="Light" Content="浅色" Margin="0,0,4,0" />
                        <Button x:Name="ThemeBandizip" Style="{StaticResource ToolButton}" Height="26"
                                Click="OnThemeClick" Tag="Bandizip" Content="深蓝" Margin="0,0,4,0" />
                        <Button x:Name="ThemeDark" Style="{StaticResource ToolButton}" Height="26"
                                Click="OnThemeClick" Tag="Dark" Content="暗色" Margin="0,0,4,0" />
                        <Button x:Name="ThemeSoft" Style="{StaticResource ToolButton}" Height="26"
                                Click="OnThemeClick" Tag="Soft" Content="暖色" />
                    </StackPanel>

                    <Separator Margin="0,8,0,8" />
                    <Button Style="{StaticResource ToolButton}" Height="26"
                            Click="OnAssociationsClick" Content="文件关联…"
                            ToolTip="设置哪些压缩包格式默认用本软件打开（默认程序被改走后可在此重绑）" />
                    <Button Style="{StaticResource ToolButton}" Height="26"
                            Click="OnAboutClick" Content="关于 极限压缩…" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- ==================== list ==================== -->
        <Grid Grid.Row="2" Background="{DynamicResource B.Surface}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- view switch: list (DataGrid) / thumbnails, compact icon buttons.
                 The style is inline: IconButton targets Button and crashes a ToggleButton
                 at XamlParse time (measured - this shipped once as a startup crash). -->
            <Border Grid.Row="0" Background="{DynamicResource B.SurfaceAlt}"
                    BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1" Padding="8,3">
                <Border.Resources>
                    <Style x:Key="ViewToggle" TargetType="ToggleButton">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{DynamicResource B.TextDim}" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Width" Value="30" />
                        <Setter Property="Height" Value="24" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Hover}" />
                                            <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.AccentSoft}" />
                                            <Setter Property="Foreground" Value="{DynamicResource B.AccentDeep}" />
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource B.Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Resources>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ToggleButton x:Name="ListModeButton" Click="OnViewModeClick" Tag="list"
                                  ToolTip="列表视图" Style="{StaticResource ViewToggle}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;" />
                    </ToggleButton>
                    <ToggleButton x:Name="ThumbModeButton" Margin="4,0,0,0" Click="OnViewModeClick" Tag="thumbs"
                                  ToolTip="缩略图视图" Style="{StaticResource ViewToggle}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE71A;" />
                    </ToggleButton>
                </StackPanel>
            </Border>

            <DataGrid x:Name="EntryGrid" Grid.Row="2" Style="{StaticResource MinimalDataGrid}"
                      Sorting="OnGridSorting" MouseDoubleClick="OnGridDoubleClick"
                      SelectionChanged="OnGridSelectionChanged"
                      PreviewMouseLeftButtonDown="OnGridPreviewMouseLeftButtonDown"
                      PreviewMouseMove="OnGridPreviewMouseMove"
                      ToolTip="把文件直接拖到资源管理器 —— 边解压边写入目标，全程不产生临时文件">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="预览图片" Click="OnPreviewClick" />
                        <MenuItem Header="用关联程序打开（临时副本）" Click="OnOpenExternallyClick" />
                        <MenuItem Header="解压选中项到…" Click="OnExtractToClick" />
                        <MenuItem Header="解压到当前文件夹" Click="OnExtractHereClick" />
                        <MenuItem Header="快速解压（同名子文件夹）" Click="OnQuickExtractClick" />
                        <Separator />
                        <MenuItem Header="测试完整性" Click="OnTestClick" />
                        <Separator />
                        <MenuItem Header="在资源管理器中显示" Click="OnRevealClick" />
                        <MenuItem Header="复制路径" Click="OnCopyPathClick" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="名称" Width="*" MinWidth="220" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                               FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"
                                               Foreground="{Binding GlyphBrush}" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding NameBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="大小" Width="110" SortMemberPath="Size"
                                        Binding="{Binding SizeText}" />
                    <DataGridTextColumn Header="压缩后" Width="110" SortMemberPath="PackedSize"
                                        Binding="{Binding PackedText}" />
                    <DataGridTextColumn Header="类型" Width="120" SortMemberPath="TypeText"
                                        Binding="{Binding TypeText}" />
                    <DataGridTextColumn Header="修改时间" Width="150" SortMemberPath="Modified"
                                        Binding="{Binding ModifiedText}" />
                    <DataGridTextColumn Header="备注" Width="160" SortMemberPath="Note"
                                        Binding="{Binding Note}" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- thumbnail view: same rows, picture-first layout -->
            <ScrollViewer x:Name="ThumbPanel" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource B.Surface}" Visibility="Collapsed">
                <WrapPanel x:Name="ThumbWrap" Margin="10" />
            </ScrollViewer>

            <StackPanel x:Name="EmptyHint" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                        IsHitTestVisible="False" Visibility="Collapsed">
                <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="42"
                           Foreground="{DynamicResource B.Border}" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyHintText" Text="把压缩包拖进来，或点左上角「打开」"
                           Margin="0,10,0,0" Foreground="{DynamicResource B.TextFaint}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ==================== progress ==================== -->
        <Border x:Name="ProgressPanel" Grid.Row="3" Background="{DynamicResource B.SurfaceAlt}"
                BorderBrush="{DynamicResource B.Border}" BorderThickness="0,1,0,0"
                Padding="10,8" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressBar x:Name="ProgressBar" Grid.Row="0" Grid.Column="0"
                             Style="{StaticResource MinimalProgressBar}" />
                <TextBlock x:Name="ProgressPercent" Grid.Row="0" Grid.Column="1" Text="0%"
                           Style="{StaticResource Caption}" Margin="10,0,0,0" MinWidth="34"
                           TextAlignment="Right" />

                <!-- Per-file bar: the current member's own progress, under the total bar. -->
                <StackPanel x:Name="FileProgressPanel" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed">
                    <TextBlock x:Name="FileProgressName" Margin="0,7,0,0" Style="{StaticResource Caption}"
                               TextTrimming="CharacterEllipsis" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="FileProgressBar" Style="{StaticResource MinimalProgressBar}" />
                        <TextBlock x:Name="FileProgressPercent" Grid.Column="1" Text="" Margin="10,0,0,0"
                                   MinWidth="34" Style="{StaticResource Caption}" TextAlignment="Right" />
                    </Grid>
                </StackPanel>

                <TextBlock x:Name="ProgressDetail" Grid.Row="2" Grid.Column="0" Margin="0,7,0,0"
                           Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                <Button x:Name="CancelButton" Grid.Row="2" Grid.Column="1" Content="取消"
                        Style="{StaticResource ToolButton}" Height="24" Margin="10,3,0,0"
                        Click="OnCancelClick" />
            </Grid>
        </Border>

        <!-- ==================== status ==================== -->
        <Border Grid.Row="4" Background="{DynamicResource B.Surface}"
                BorderBrush="{DynamicResource B.Border}" BorderThickness="0,1,0,0"
                Padding="10,5">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="StatusLeft" DockPanel.Dock="Left" Style="{StaticResource Caption}"
                           Text="就绪" />
                <TextBlock x:Name="StatusRight" DockPanel.Dock="Right" Style="{StaticResource Caption}"
                           TextAlignment="Right" Margin="10,0,0,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
