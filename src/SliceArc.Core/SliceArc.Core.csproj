<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Required for the VolumeAwareStream CCW: 7z.dll calls back into
         managed code through IInStream, so built-in COM interop must stay on. -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared with SliceArc.ShellExt: one source of truth for "does this file
         name look like an archive". The ShellExt compiles the same file, so the
         classic menu and the Windows 11 modern menu cannot drift apart again. -->
    <Compile Include="..\Shared\ArchiveNameHeuristics.cs" Link="Shared\ArchiveNameHeuristics.cs" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>SliceArc.Probe</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>SliceArc.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
